nextflow_process {

    name "Test Process NOHUMAN"
    script "modules/local/nohuman/main.nf"
    config "tests/nextflow.config"
    process "NOHUMAN"

    tag "modules"
    tag "nohuman"

    test("Remove host DNA and output clean reads - gzip") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file(params.modules_testdata_base_path + "SRR22957083_subset_withhuman.fastq.gz", checkIfExists: true)
                ]

                input[1] = file(params.nohuman_db)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match("versions_gzipped") },
                { assert path(process.out.log.get(0)).text.contains("sequences classified as human") },
            )
        }

    }

    test("Remove host DNA and output clean reads - uncompressed") {

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file(params.modules_testdata_base_path + "SRR22957083_subset_withhuman.fastq", checkIfExists: true)
                ]

                input[1] = file(params.nohuman_db)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match("versions_uncompressed") },
                { assert path(process.out.log.get(0)).text.contains("sequences classified as human") },
            )
        }

    }

    test("Remove host DNA and output clean reads - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file(params.modules_testdata_base_path + "SRR22957083_subset_withhuman.fastq.gz", checkIfExists: true)
                ]

                input[1] = file(params.nohuman_db)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
