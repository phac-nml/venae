
nextflow_process {

    name "Test Process EMMTYPER"
    script "../main.nf"
    process "EMMTYPER"

    tag "modules"
    tag "emmtyper"

    test("test_emmtyper") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file("${projectDir}/tests/test_data/SRR22957083_assembly.fasta", checkIfExists: true)
                ]

                input[1] = file(params.emmtyper_db).parent
                input[2] = file(params.emmtyper_db).name
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert snapshot(process.out.versions).match("versions") },
                { assert path(process.out.tsv.get(0).get(1)).text.contains("A-C4") }
            )
        }
    }

    test("test_emmtyper - stub") {

        options '-stub'

        when {
            params {

            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file("${projectDir}/tests/test_data/SRR22957083_assembly.fasta", checkIfExists: true)
                ]

                input[1] = file(params.emmtyper_db).parent
                input[2] = file(params.emmtyper_db).name
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
            )
        }
    }

}
