nextflow_process {

    name "Test Process COVERM_GENOME"
    script "../main.nf"
    process "COVERM_GENOME"

    tag "modules"
    tag "coverm/genome"

    test("coverm_genome - fastq") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file(params.modules_testdata_base_path + "SRR26162843_subset_withhuman.fastq.gz", checkIfExists: true),
                    file(params.modules_testdata_base_path + "SRR26162843_assembly.fasta", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match("versions") },
                { assert snapshot(file(process.out.report.get(0).get(1)).readLines()[0]).match() },
                { assert path(process.out.report.get(0).get(1)).text.contains("SRR26162843_assembly\t3.") },
            )
        }

    }

    test("coverm_genome - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file(params.modules_testdata_base_path + "SRR26162843_subset_withhuman.fastq.gz", checkIfExists: true),
                    file(params.modules_testdata_base_path + "SRR26162843_assembly.fasta", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }
}
