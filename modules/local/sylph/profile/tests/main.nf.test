nextflow_process {

    name "Test Process SYLPH_PROFILE"
    script "../main.nf"
    process "SYLPH_PROFILE"
    tag "modules"
    tag "sylph"
    tag "sylph_profile"

    test("sylph ont") {
        when {
            process {
                """
                input[0] = file(params.modules_testdata_base_path + "SRR22957083_cleanfilt2k.fastq.gz.sylsp", checkIfExists: true)
                input[1] = file(params.sylph_db_bac, checkIfExists: true)
                input[2] = file(params.sylph_db_fungi, checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out.versions,
                file(process.out.profile_out[0]).readLines()[0]
            ).match()
        }
    }

    test("sylph ont - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = file(params.modules_testdata_base_path + "SRR22957083_cleanfilt2k.fastq.gz.sylsp", checkIfExists: true)
                input[1] = file(params.sylph_db_bac, checkIfExists: true)
                input[2] = file(params.sylph_db_fungi, checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
