nextflow_process {

    name "Test Process KMERRESISTANCE"
    script "modules/local/kmerresistance/main.nf"
    process "KMERRESISTANCE"

    tag "modules"
    tag "kmerresistance"

    test("Run kmerresistance") {

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file("${projectDir}/tests/test_data/SRR26162843_assembly.fasta", checkIfExists: true)
                ]

                input[1] = file(params.kmerresistance_db_arg).parent
                input[2] = file(params.kmerresistance_db_arg).name
                input[3] = file(params.kmerresistance_db_spp).name
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.versions).match("versions") },
                { assert path(process.out.report.get(0).get(1)).text.contains("aadA2_2_JQ364967") },
            )
        }

    }

    test("Run kmerresistance - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:true ], // meta map
                    file("${projectDir}/tests/test_data/SRR26162843_assembly.fasta", checkIfExists: true)
                ]

                input[1] = file(params.kmerresistance_db_arg).parent
                input[2] = file(params.kmerresistance_db_arg).name
                input[3] = file(params.kmerresistance_db_spp).name
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }
}
